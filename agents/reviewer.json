{
  "description": "The single-seat reviewer: correctness and security in one pass, for recipes without a review panel.",
  "charter": "charters/reviewer.md",
  "models": [
    "fable",
    "opus",
    "sol"
  ],
  "efforts": {
    "fable": "xhigh",
    "opus": "xhigh",
    "sol": "xhigh"
  },
  "hands": {
    "kind": "workspace",
    "network": false,
    "binds": [
      {
        "path": "~/.cargo",
        "mode": "overlay",
        "mask": [
          "credentials.toml",
          "credentials"
        ]
      },
      {
        "path": "~/.rustup",
        "mode": "ro"
      }
    ]
  },
  "limits": {
    "max_attempts": 2,
    "timeout_seconds": 3600
  }
}
