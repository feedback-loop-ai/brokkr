{
  "description": "Verifier for spec-driven delivery: the same charter, carrying the spec-kit CLI permission.",
  "charter": "charters/verifier.md",
  "models": [
    "sonnet",
    "opus"
  ],
  "tools": {
    "allow": [
      "cargo",
      "git",
      "python3",
      "pytest",
      "ls",
      "rg",
      "mkdir",
      "specify"
    ],
    "mcp": []
  },
  "limits": {
    "max_attempts": 2,
    "timeout_seconds": 3600
  }
}
