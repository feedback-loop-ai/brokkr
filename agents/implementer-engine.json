{
  "description": "Engine-class implementer: builds core, store, contract, and policy work selected by triage.",
  "charter": "charters/implementer.md",
  "models": [
    "astra",
    "fable"
  ],
  "efforts": {
    "astra": "high",
    "fable": "high"
  },
  "hands": {
    "kind": "workspace",
    "network": false,
    "binds": [
      {
        "path": "~/.cargo",
        "mode": "overlay",
        "mask": [
          "credentials.toml",
          "credentials"
        ]
      },
      {
        "path": "~/.rustup",
        "mode": "ro"
      }
    ]
  },
  "limits": {
    "max_attempts": 2,
    "timeout_seconds": 7200
  }
}
