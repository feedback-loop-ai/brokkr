{
  "description": "Shipper for spec-driven delivery: the same charter, carrying the spec-kit CLI permission.",
  "charter": "charters/shipper.md",
  "models": [
    "sonnet",
    "opus"
  ],
  "efforts": {
    "sonnet": "high",
    "opus": "high"
  },
  "tools": {
    "allow": [
      "cargo",
      "git",
      "python3",
      "pytest",
      "ls",
      "rg",
      "mkdir",
      "specify"
    ],
    "mcp": []
  },
  "limits": {
    "max_attempts": 2,
    "timeout_seconds": 1800
  }
}
