{
  "description": "Prepares a release from committed changes, reconciles documentation and organization profiles, and records the remaining publication work from the realm's release configuration.",
  "charter": "charters/release-manager.md",
  "models": [
    "opus",
    "astra"
  ],
  "efforts": {
    "opus": "medium",
    "astra": "medium"
  },
  "hands": {
    "kind": "workspace",
    "network": true,
    "binds": [
      {
        "path": "~/.cargo",
        "mode": "overlay",
        "mask": [
          "credentials.toml",
          "credentials"
        ]
      },
      {
        "path": "~/.rustup",
        "mode": "ro"
      },
      {
        "path": "/etc/resolv.conf",
        "mode": "ro"
      },
      {
        "path": "/etc/nsswitch.conf",
        "mode": "ro"
      },
      {
        "path": "/etc/ssl/certs",
        "mode": "ro"
      }
    ]
  },
  "limits": {
    "max_attempts": 2,
    "timeout_seconds": 7200
  }
}
