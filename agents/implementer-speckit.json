{
  "description": "Implementer for spec-driven delivery: builds to the committed spec, ticking tasks.md as it goes.",
  "charter": "charters/implementer-speckit.md",
  "models": [
    "opus",
    "sonnet"
  ],
  "efforts": {
    "opus": "high",
    "sonnet": "high"
  },
  "tools": {
    "allow": [
      "cargo",
      "git",
      "python3",
      "pytest",
      "ls",
      "rg",
      "mkdir",
      "specify",
      "codex",
      "dsh"
    ],
    "mcp": []
  },
  "limits": {
    "max_attempts": 2,
    "timeout_seconds": 5400
  }
}
