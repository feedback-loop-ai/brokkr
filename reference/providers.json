    "codex": {
      "runner": "codex",
      "auth": "subscription_or_api",
      "billing_modes": [
        "subscription",
        "api"
      ]
    },
    "claude": {
      "runner": "claude",
      "auth": "subscription_or_api",
      "billing_modes": [
        "subscription",
        "api"
      ]
    },
    "deepseek": {
      "runner": "claude_anthropic_compatible",
      "auth": "api_key",
      "auth_env": "DEEPSEEK_API_KEY",
      "billing_modes": [
        "api"
      ],
      "allowed_visibility": [
        "public"
      ],
      "allowed_roles": [
        "council-seat",
        "implementer",
        "fixer",
        "contract-checker",
        "gate-auditor"
      ],
      "allowed_write_roles": [
        "implementer",
        "fixer"
