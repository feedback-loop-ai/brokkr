        "dashscope.aliyuncs.com",
        "dashscope-intl.aliyuncs.com",
        "dashscope-us.aliyuncs.com",
        "cn-hongkong.dashscope.aliyuncs.com",
        "coding-intl.dashscope.aliyuncs.com"
      ],
      "allowed_base_url_suffixes": [
        ".maas.aliyuncs.com"
      ],
      "billing_modes": [
        "api"
      ],
      "allowed_visibility": [
        "public"
      ],
      "allowed_roles": [
        "council-seat",
        "visual-verifier"
      ],
      "allowed_write_roles": [],
