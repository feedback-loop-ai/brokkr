{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback-loop.ai/forge/heritage/council-adjudication.schema.json",
  "type": "object",
  "required": ["agreed", "contested"],
  "properties": {
    "agreed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "answer"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "answer": {"type": "string"}
        }
      }
    },
    "contested": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "options"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": ".*\\S.*"}
          },
          "why_it_matters": {"type": "string"}
        }
      }
    }
  }
}
