// Self-hosted Renovate's global configuration (issue #339, operator ruling
// 2026-09-26). .github/workflows/renovate.yml runs Renovate with this file,
// as the org's GitHub App, against this repository alone; what it updates
// and how is .github/renovate.json5.
{
  platform: 'github',
  onboarding: false,
  requireConfig: 'required',
  // Names listed in `configFileNames` are checked before Renovate's built-in
  // list, and the first file found is the one used; listing the pinned file
  // ensures Renovate reads `.github/renovate.json5` whenever it exists, and
  // the digest guard refuses a tree where it does not.
  configFileNames: ['.github/renovate.json5'],
  // Renovate cannot compute release tarball or workflow file digests.
  // `refresh-pin-checksums.sh` re-downloads a bumped tool release and rewrites
  // its sha256; `refresh-workflow-digests.sh` refreshes `.github/workflow-digests.txt`
  // after any workflow or local action edit. Both fail closed.
  allowedCommands: [
    '^bash scripts/refresh-pin-checksums\\.sh$',
    '^bash scripts/refresh-workflow-digests\\.sh$',
  ],
  // Lock files are regenerated with the tools they need (cargo, npm).
  binarySource: 'install',
}
