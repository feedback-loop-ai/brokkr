{
  "name": "verify",
  "policy": "policy.json",
  "protected_phase": "review",
  "seats": {
    "verify": {
      "results": [
        "pass",
        "fail"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/verify-seat.sh",
          "{prompt_file}"
        ]
      },
      "hands": {"kind": "workspace", "network": false, "binds": [
        {"path": "~/.cargo", "mode": "overlay", "mask": ["credentials.toml", "credentials"]},
        {"path": "~/.rustup", "mode": "ro"}
      ]}
    },
    "review": {
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "agent": "verify-reviewer"
    }
  }
}
