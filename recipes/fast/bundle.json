{
  "name": "fast",
  "description": "Default Rust delivery from implementation through verification, review, and ship.",
  "cost": "medium",
  "policy": "policy.json",
  "protected_phase": "review",
  "seats": {
    "implement": {
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 5400
      },
      "agent": "fast-implementer"
    },
    "verify": {
      "results": [
        "pass",
        "fail"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/verify-seat.sh",
          "{prompt_file}"
        ]
      },
      "hands": {
        "kind": "workspace",
        "network": false,
        "binds": [
          {"path": "~/.cargo", "mode": "overlay", "mask": ["credentials.toml", "credentials"]},
          {"path": "~/.rustup", "mode": "ro"}
        ]
      }
    },
    "review": {
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "agent": "fast-reviewer"
    },
    "ship": {
      "results": [
        "ready",
        "shipped"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1800
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/ship-seat.sh",
          "{prompt_file}",
          "{brokkr}"
        ]
      },
      "hands": {
        "kind": "workspace",
        "network": false,
        "binds": []
      }
    }
  }
}
