{
  "name": "fast",
  "policy": "policy.json",
  "protected_phase": "review",
  "seats": {
    "implement": {
      "role": "roles/implementer.md",
      "results": [
        "complete",
        "broken",
        "blocked"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 5400
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)"
        ]
      }
    },
    "verify": {
      "role": "roles/verifier.md",
      "results": [
        "pass",
        "fail"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)"
        ]
      }
    },
    "review": {
      "role": "roles/reviewer.md",
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "class": "gate",
      "inputs": [
        "fixes_applied",
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)"
        ]
      }
    },
    "ship": {
      "role": "roles/shipper.md",
      "results": [
        "ready",
        "shipped"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1800
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)"
        ]
      }
    }
  }
}