{
  "name": "wager-harness",
  "description": "Driver evaluation that swaps only implementation to Codex for a fair wager.",
  "cost": "medium",
  "extends": "fast",
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "seats": [
      "implement"
    ]
  },
  "seats": {
    "implement": {
      "role": "roles/implementer.md",
      "results": [
        "complete",
        "broken",
        "blocked"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 5400
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "codex",
          "--",
          "--model",
          "gpt-5.6-sol",
          "--effort",
          "medium",
          "--sandbox",
          "danger-full-access"
        ]
      }
    }
  }
}
