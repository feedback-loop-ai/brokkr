{
  "name": "sdd",
  "description": "Spec-driven work that needs a design panel, chief synthesis, and spec-kit check.",
  "cost": "high",
  "policy": "policy.json",
  "protected_phase": "review",
  "seats": {
    "intake": {
      "results": [
        "resolved"
      ],
      "class": "work",
      "agent": "intake-speckit"
    },
    "design": {
      "results": [
        "designed",
        "fail"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "sequence": [
        {
          "name": "positions",
          "aggregate": "unanimous-pass",
          "panel": {
            "simplicity": {
              "agent": "position-simplicity",
              "class": "work"
            },
            "robustness": {
              "agent": "position-robustness",
              "class": "work"
            }
          }
        },
        {
          "name": "chief",
          "agent": "chief-architect",
          "class": "work"
        },
        {
          "name": "speckit-check",
          "role": "roles/speckit-check.md",
          "class": "gate",
          "hands": "workspace",
          "driver": {
            "command": [
              "{brokkr}",
              "driver",
              "exec",
              "--",
              "bash",
              "recipes/sdd/drivers/speckit_check.sh",
              "{prompt_file}"
            ]
          }
        }
      ]
    },
    "implement": {
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ],
      "class": "work",
      "agent": "implementer-speckit"
    },
    "verify": {
      "results": [
        "pass",
        "fail"
      ],
      "class": "gate",
      "agent": "verifier"
    },
    "review": {
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "inputs": [
        "spec_defect",
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "aggregate": "review-panel",
      "panel": {
        "spec-compliance": {
          "agent": "review-spec-compliance",
          "class": "gate"
        },
        "security": {
          "agent": "review-security",
          "class": "gate"
        }
      }
    },
    "ship": {
      "results": [
        "ready",
        "shipped"
      ],
      "class": "gate",
      "agent": "shipper"
    }
  }
}
