{
  "name": "crucible",
  "description": "Engine, store, protocol, or contract changes needing a review panel and chief.",
  "cost": "high",
  "extends": "fast",
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "seats": [
      "implement",
      "verify",
      "review",
      "ship"
    ]
  },
  "seats": {
    "implement": {
      "agent": "implementer-engine",
      "class": "work",
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ]
    },
    "verify": {
      "class": "gate",
      "results": [
        "pass",
        "fail"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "driver": {"command": ["{brokkr}", "driver", "exec", "--", "bash", "./scripts/verify-seat.sh", "{prompt_file}"]},
      "hands": {"kind": "workspace", "network": false, "binds": [
        {"path": "~/.cargo", "mode": "overlay", "mask": ["credentials.toml", "credentials"]},
        {"path": "~/.rustup", "mode": "ro"}
      ]}
    },
    "review": {
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "inputs": [
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 7200
      },
      "sequence": [
        {
          "name": "positions",
          "aggregate": "review-panel",
          "panel": {
            "correctness": {
              "agent": "review-correctness",
              "class": "gate"
            },
            "security": {
              "agent": "review-security",
              "class": "gate"
            }
          }
        },
        {
          "name": "chief",
          "agent": "review-chief",
          "class": "gate"
        }
      ]
    },
    "ship": {
      "class": "gate",
      "results": [
        "ready",
        "shipped"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1800
      },
      "driver": {"command": ["{brokkr}", "driver", "exec", "--", "bash", "./scripts/ship-seat.sh", "{prompt_file}", "{brokkr}"]},
      "hands": {"kind": "workspace", "network": false, "binds": []}
    }
  }
}
