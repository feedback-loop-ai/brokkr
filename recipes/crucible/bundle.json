{
  "name": "crucible",
  "description": "Engine, store, protocol, or contract changes needing an Opus review sequence.",
  "cost": "high",
  "extends": "fast",
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "seats": [
      "implement",
      "verify",
      "review",
      "ship"
    ]
  },
  "seats": {
    "implement": {
      "role": "roles/implementer.md",
      "results": [
        "complete",
        "broken",
        "blocked"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 7200
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)",
          "--model",
          "claude-opus-5",
          "--effort",
          "high"
        ]
      }
    },
    "verify": {
      "role": "roles/verifier.md",
      "results": [
        "pass",
        "fail"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 7200
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)",
          "--model",
          "claude-opus-5",
          "--effort",
          "high"
        ]
      }
    },
    "review": {
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "inputs": [
        "fixes_applied",
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 7200
      },
      "sequence": [
        {
          "name": "positions",
          "aggregate": "review-panel",
          "panel": {
            "correctness": {
              "role": "roles/position-correctness.md",
              "class": "work",
              "driver": {
                "command": [
                  "{brokkr}",
                  "driver",
                  "claude",
                  "--",
                  "--permission-mode",
                  "acceptEdits",
                  "--allowedTools",
                  "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)",
                  "--model",
                  "claude-opus-5",
                  "--effort",
                  "high"
                ]
              }
            },
            "security": {
              "role": "roles/position-security.md",
              "class": "work",
              "driver": {
                "command": [
                  "{brokkr}",
                  "driver",
                  "claude",
                  "--",
                  "--permission-mode",
                  "acceptEdits",
                  "--allowedTools",
                  "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)",
                  "--model",
                  "claude-opus-5",
                  "--effort",
                  "high"
                ]
              }
            }
          }
        },
        {
          "name": "chief",
          "role": "roles/review-chief.md",
          "class": "gate",
          "driver": {
            "command": [
              "{brokkr}",
              "driver",
              "claude",
              "--",
              "--permission-mode",
              "acceptEdits",
              "--allowedTools",
              "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)",
              "--model",
              "claude-opus-5",
              "--effort",
              "high"
            ]
          }
        }
      ]
    },
    "ship": {
      "role": "roles/shipper.md",
      "results": [
        "ready",
        "shipped"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1800
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)",
          "--model",
          "claude-opus-5",
          "--effort",
          "high"
        ]
      }
    }
  }
}
