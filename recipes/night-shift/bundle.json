{
  "name": "night-shift",
  "description": "Unattended work that should park on the first unusual result instead of retrying.",
  "cost": "medium-high",
  "extends": "fast",
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "seats": [
      "implement",
      "verify",
      "review",
      "ship"
    ]
  },
  "seats": {
    "implement": {
      "role": "roles/implementer.md",
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 7200
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "dsh",
          "--",
          "--model",
          "deepseek/deepseek-v4-flash",
          "--effort",
          "medium"
        ]
      }
    },
    "verify": {
      "class": "gate",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 3600
      },
      "results": [
        "pass",
        "fail"
      ],
      "driver": {"command": ["{brokkr}", "driver", "exec", "--", "bash", "scripts/verify-seat.sh", "{prompt_file}"]},
      "hands": {"kind": "workspace", "network": false, "binds": [
        {"path": "~/.cargo", "mode": "overlay", "mask": ["credentials.toml", "credentials"]},
        {"path": "~/.rustup", "mode": "ro"}
      ]}
    },
    "review": {
      "agent": "reviewer",
      "class": "gate",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 3600
      },
      "results": [
        "clean",
        "residual",
        "security-hold"
      ]
    },
    "ship": {
      "class": "gate",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 1800
      },
      "results": [
        "ready",
        "shipped"
      ],
      "driver": {"command": ["{brokkr}", "driver", "exec", "--", "bash", "scripts/ship-seat.sh", "{prompt_file}", "{brokkr}"]},
      "hands": {"kind": "workspace", "network": false, "binds": [
        {"path": "~/.cargo", "mode": "overlay", "mask": ["credentials.toml", "credentials"]},
        {"path": "~/.rustup", "mode": "ro"}
      ]}
    }
  }
}
