{
  "name": "night-shift",
  "description": "Unattended triage routing that parks on the first unusual result and uses the dsh implementation lane.",
  "cost": "medium-high",
  "extends": "triage",
  "override": {
    "bundle": ["description", "cost"],
    "seats": ["implement"],
    "limits": ["triage", "specify", "clarify", "design", "tasks", "analyze", "verify", "review", "ship"]
  },
  "seats": {
    "triage": {"limits": {"max_attempts": 1, "timeout_seconds": 3600}},
    "specify": {"limits": {"max_attempts": 1, "timeout_seconds": 3600}},
    "clarify": {"limits": {"max_attempts": 1, "timeout_seconds": 3600}},
    "design": {"limits": {"max_attempts": 1, "timeout_seconds": 3600}},
    "tasks": {"limits": {"max_attempts": 1, "timeout_seconds": 3600}},
    "analyze": {"limits": {"max_attempts": 1, "timeout_seconds": 3600}},
    "implement": {
      "role": "roles/implementer.md",
      "results": ["complete", "broken", "blocked", "oversized"],
      "class": "work",
      "limits": {"max_attempts": 1, "timeout_seconds": 7200},
      "driver": {"command": ["{brokkr}", "driver", "dsh", "--", "--model", "deepseek/deepseek-v4-flash", "--effort", "medium"]}
    },
    "verify": {"limits": {"max_attempts": 1, "timeout_seconds": 3600}},
    "review": {"limits": {"max_attempts": 1, "timeout_seconds": 3600}},
    "ship": {"limits": {"max_attempts": 1, "timeout_seconds": 1800}}
  }
}
