{
  "name": "night-shift",
  "description": "Unattended work that should park on the first unusual result instead of retrying.",
  "cost": "medium-high",
  "extends": "fast",
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "seats": [
      "implement",
      "verify",
      "review",
      "ship"
    ]
  },
  "seats": {
    "implement": {
      "role": "roles/implementer.md",
      "results": [
        "complete",
        "broken",
        "blocked"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 7200
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "dsh",
          "--",
          "--model",
          "deepseek/deepseek-v4-flash",
          "--effort",
          "medium"
        ]
      }
    },
    "verify": {
      "agent": "verifier",
      "class": "gate",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 3600
      },
      "results": [
        "pass",
        "fail"
      ]
    },
    "review": {
      "agent": "reviewer",
      "class": "gate",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 3600
      },
      "results": [
        "clean",
        "residual",
        "security-hold"
      ]
    },
    "ship": {
      "agent": "shipper",
      "class": "gate",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 1800
      },
      "results": [
        "ready",
        "shipped"
      ]
    }
  }
}
