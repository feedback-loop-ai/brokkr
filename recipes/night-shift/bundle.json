{
  "name": "night-shift",
  "description": "Unattended work that should park on the first unusual result instead of retrying.",
  "cost": "medium-high",
  "extends": "fast",
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "seats": [
      "implement",
      "verify",
      "review",
      "ship"
    ]
  },
  "seats": {
    "implement": {
      "role": "roles/implementer.md",
      "results": [
        "complete",
        "broken",
        "blocked"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 7200
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "dsh",
          "--",
          "--model",
          "deepseek/deepseek-v4-flash"
        ]
      }
    },
    "verify": {
      "role": "roles/verifier.md",
      "results": [
        "pass",
        "fail"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 3600
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)",
          "--model",
          "claude-opus-5"
        ]
      }
    },
    "review": {
      "role": "roles/reviewer.md",
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "class": "gate",
      "inputs": [
        "fixes_applied",
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 3600
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)",
          "--model",
          "claude-opus-5"
        ]
      }
    },
    "ship": {
      "role": "roles/shipper.md",
      "results": [
        "ready",
        "shipped"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 1800
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(mkdir:*)",
          "--model",
          "claude-opus-5"
        ]
      }
    }
  }
}
