{
  "name": "ember",
  "description": "Docs, chores, and small fixes using the shared agent roster.",
  "cost": "low",
  "extends": "fast",
  "policy": "policy.json",
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "seats": [
      "implement",
      "verify",
      "review",
      "ship"
    ],
    "table": [
      "description",
      "initial"
    ]
  },
  "seats": {
    "intake": {
      "agent": "intake",
      "class": "work",
      "results": [
        "resolved"
      ]
    },
    "implement": {
      "agent": "implementer",
      "class": "work",
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ]
    },
    "verify": {
      "agent": "verifier",
      "class": "gate",
      "results": [
        "pass",
        "fail"
      ]
    },
    "review": {
      "agent": "reviewer",
      "class": "gate",
      "results": [
        "clean",
        "residual",
        "security-hold"
      ]
    },
    "ship": {
      "agent": "shipper",
      "class": "gate",
      "results": [
        "ready",
        "shipped"
      ]
    }
  }
}
