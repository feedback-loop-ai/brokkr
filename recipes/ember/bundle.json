{
  "name": "ember",
  "description": "Docs, chores, and small fixes using the shared agent roster.",
  "cost": "low",
  "extends": "fast",
  "policy": "policy.json",
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "seats": [
      "implement",
      "verify",
      "review",
      "ship"
    ],
    "table": [
      "description",
      "initial"
    ]
  },
  "seats": {
    "intake": {
      "agent": "intake",
      "class": "work",
      "results": [
        "resolved"
      ]
    },
    "implement": {
      "agent": "implementer",
      "class": "work",
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ]
    },
    "verify": {
      "class": "gate",
      "results": [
        "pass",
        "fail"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "driver": {"command": ["{brokkr}", "driver", "exec", "--", "bash", "scripts/verify-seat.sh", "{prompt_file}"]},
      "hands": {"kind": "workspace", "network": false, "binds": [
        {"path": "~/.cargo", "mode": "overlay", "mask": ["credentials.toml", "credentials"]},
        {"path": "~/.rustup", "mode": "ro"}
      ]}
    },
    "review": {
      "agent": "reviewer",
      "class": "gate",
      "results": [
        "clean",
        "residual",
        "security-hold"
      ]
    },
    "ship": {
      "class": "gate",
      "results": [
        "ready",
        "shipped"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1800
      },
      "driver": {"command": ["{brokkr}", "driver", "exec", "--", "bash", "scripts/ship-seat.sh", "{prompt_file}", "{brokkr}"]},
      "hands": {"kind": "workspace", "network": false, "binds": []}
    }
  }
}
