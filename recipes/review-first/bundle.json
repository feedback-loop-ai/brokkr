{
  "name": "review-first",
  "description": "An existing branch judged first: Sol reviews, the suite verifies, Muse remediates findings on return, and the run ships.",
  "extends": "fast",
  "policy": "policy.json",
  "override": {
    "bundle": ["description"],
    "table": ["initial", "description"],
    "seats": ["review", "implement"]
  },
  "seats": {
    "review": {
      "role": "roles/reviewer.md",
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "class": "gate",
      "inputs": [
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "tools": {
        "sandbox": "read-only"
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "codex",
          "--",
          "--model",
          "gpt-6.1-sol",
          "--effort",
          "high"
        ]
      }
    },
    "implement": {
      "role": "roles/implementer.md",
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 5400
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "dsh",
          "--",
          "--model",
          "meta-contributor/meta/muse-spark-1.3-contributor",
          "--effort",
          "xhigh"
        ]
      }
    }
  }
}
