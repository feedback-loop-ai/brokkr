{
  "name": "node",
  "description": "Node and TypeScript repositories using JavaScript-specific seats and tools.",
  "extends": "fast",
  "policy": "policy.json",
  "override": {
    "bundle": ["description"],
    "table": ["description"],
    "rules": [
      "IMPL-BROKEN-TWICE",
      "IMPL-BROKEN-RETRY",
      "IMPL-BLOCKED",
      "IMPL-OK-DOCS-RETURN",
      "IMPL-OK",
      "VERIFY-FAIL-EXHAUSTED",
      "VERIFY-FAIL"
    ],
    "seats": ["implement", "verify", "review"],
    "limits": ["ship"]
  },
  "seats": {
    "implement": {
      "role": "roles/implementer.md",
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 4800
      },
      "tools": {
        "allow": [
          "npm",
          "npx",
          "node",
          "git",
          "ls",
          "rg",
          "mkdir"
        ]
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--model",
          "claude-fable-5-1",
          "--effort",
          "high"
        ]
      }
    },
    "verify": {
      "results": [
        "pass",
        "fail"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 2400
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./roles/verify-seat.sh",
          "{prompt_file}"
        ]
      },
      "hands": {"kind": "workspace", "network": false, "binds": [
        {"path": "~/.npm", "mode": "overlay"}
      ]}
    },
    "review": {
      "role": "roles/reviewer.md",
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "class": "gate",
      "inputs": [
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3000
      },
      "tools": {
        "allow": [
          "npm",
          "npx",
          "node",
          "git",
          "ls",
          "rg",
          "mkdir"
        ]
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--model",
          "claude-fable-5-1",
          "--effort",
          "high"
        ]
      }
    },
    "ship": {
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1200
      }
    }
  }
}
