{
  "name": "node",
  "description": "Node and TypeScript repositories using JavaScript-specific seats and tools.",
  "extends": "fast",
  "policy": "policy.json",
  "override": {
    "bundle": ["description"],
    "table": ["description"],
    "seats": ["implement", "verify", "review"],
    "limits": ["ship"]
  },
  "seats": {
    "implement": {
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 4800
      },
      "agent": "node-implementer"
    },
    "verify": {
      "results": [
        "pass",
        "fail"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 2400
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./roles/verify-seat.sh",
          "{prompt_file}"
        ]
      },
      "hands": {"kind": "workspace", "network": false, "binds": [
        {"path": "~/.npm", "mode": "overlay"}
      ]}
    },
    "review": {
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3000
      },
      "agent": "node-reviewer"
    },
    "ship": {
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1200
      }
    }
  }
}
