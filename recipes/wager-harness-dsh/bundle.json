{
  "name": "wager-harness-dsh",
  "description": "Driver evaluation that swaps only implementation to DSH for a fair wager.",
  "cost": "medium",
  "extends": "fast",
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "seats": [
      "implement"
    ]
  },
  "seats": {
    "implement": {
      "role": "roles/implementer.md",
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ],
      "class": "work",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 5400
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "dsh",
          "--",
          "--model",
          "spark-glm/GLM-5.3-Flash-EXL3"
        ]
      }
    }
  }
}
