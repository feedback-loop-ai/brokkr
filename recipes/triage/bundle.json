{
  "name": "triage",
  "description": "Routing delivery: a chief-grade triage gate rules the class before Fast's crew, adding the current SDD design council when ruled.",
  "cost": "variable",
  "extends": "fast",
  "policy": "policy.json",
  "seats": {
    "triage": {
      "results": [
        "chore",
        "feature",
        "design",
        "engine",
        "escalate"
      ],
      "class": "gate",
      "limits": {"max_attempts": 1, "timeout_seconds": 1800},
      "agent": "triage"
    },
    "implement": {
      "results": ["complete", "broken", "blocked", "oversized"],
      "limits": {"max_attempts": 2, "timeout_seconds": 7200},
      "select": {
        "on": "strategy",
        "cases": {
          "chore": {"agent": "implementer", "class": "work"},
          "feature": {"agent": "implementer", "class": "work"},
          "design": {"agent": "implementer-sdd", "class": "work"},
          "engine": {"agent": "implementer-engine", "class": "work"}
        }
      }
    },
    "review": {
      "results": ["clean", "residual", "security-hold"],
      "inputs": ["spec_defect", "has_security_residual", "max_residual_severity"],
      "limits": {"max_attempts": 2, "timeout_seconds": 7200},
      "select": {
        "on": "strategy",
        "cases": {
          "chore": {"agent": "reviewer", "class": "gate"},
          "feature": {
            "aggregate": "review-panel",
            "panel": {
              "correctness": {"agent": "review-correctness", "class": "gate"},
              "security": {"agent": "review-security", "class": "gate"}
            }
          },
          "design": {
            "sequence": [
              {"name": "positions", "results": ["clean", "residual", "security-hold"], "aggregate": "review-panel", "panel": {
                "correctness": {"agent": "review-correctness", "class": "gate"},
                "security": {"agent": "review-security", "class": "gate"},
                "spec-compliance": {"agent": "review-spec-compliance", "class": "gate"}
              }},
              {"name": "chief", "agent": "review-chief", "class": "gate"}
            ]
          },
          "engine": {
            "sequence": [
              {"name": "positions", "results": ["clean", "residual", "security-hold"], "aggregate": "review-panel", "panel": {
                "adversarial": {"agent": "review-adversarial", "class": "gate"},
                "correctness": {"agent": "review-correctness", "class": "gate"},
                "security": {"agent": "review-security", "class": "gate"},
                "spec-compliance": {"agent": "review-spec-compliance", "class": "gate"}
              }},
              {"name": "chief", "agent": "review-chief", "class": "gate"}
            ]
          }
        }
      }
    },
    "specify": {
      "results": ["drafted", "fail", "upstream"],
      "inputs": ["change"],
      "limits": {"max_attempts": 2, "timeout_seconds": 3600},
      "sequence": [
        {"name": "author", "results": ["drafted", "upstream"], "agent": "chief-architect", "class": "work"},
        {"name": "validate", "dialect": "validate"}
      ]
    },
    "clarify": {
      "results": ["clear", "ambiguous"],
      "limits": {"max_attempts": 2, "timeout_seconds": 3600},
      "sequence": [
        {"name": "check", "results": ["clear", "ambiguous"], "dialect": "check"},
        {"name": "judge", "agent": "clarifier", "class": "gate"}
      ]
    },
    "design": {
      "results": ["drafted", "fail", "upstream"],
      "inputs": ["change"],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "sequence": [
        {
          "name": "positions",
          "results": ["pass", "fail"],
          "aggregate": "unanimous-pass",
          "panel": {
            "simplicity": {
              "agent": "position-simplicity",
              "class": "work"
            },
            "robustness": {
              "agent": "position-robustness",
              "class": "work"
            }
          }
        },
        {
          "name": "chief",
          "results": ["drafted", "upstream"],
          "agent": "chief-architect",
          "class": "work"
        },
        {
          "name": "validate",
          "dialect": "validate"
        }
      ]
    },
    "tasks": {
      "results": ["drafted", "fail", "upstream"],
      "inputs": ["change"],
      "limits": {"max_attempts": 2, "timeout_seconds": 3600},
      "sequence": [
        {"name": "author", "results": ["drafted", "upstream"], "agent": "implementer-sdd", "class": "work"},
        {"name": "validate", "dialect": "validate"}
      ]
    },
    "analyze": {
      "results": ["consistent", "drift"],
      "inputs": ["drift_in"],
      "limits": {"max_attempts": 2, "timeout_seconds": 3600},
      "sequence": [
        {"name": "check", "results": ["consistent", "drift"], "dialect": "check"},
        {"name": "judge", "agent": "analyst", "class": "gate"}
      ]
    }
  },
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "table": [
      "description",
      "phases",
      "initial"
    ],
    "seats": [
      "implement",
      "review"
    ]
  }
}
