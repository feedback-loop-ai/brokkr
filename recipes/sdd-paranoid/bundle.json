{
  "name": "sdd-paranoid",
  "description": "Spec-driven high-risk work needing adversarial and security review.",
  "cost": "very high",
  "extends": "sdd",
  "override": {
    "bundle": [
      "description",
      "cost"
    ],
    "seats": [
      "review"
    ]
  },
  "seats": {
    "review": {
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "inputs": [
        "spec_defect",
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "aggregate": "review-panel",
      "panel": {
        "adversarial": {
          "agent": "review-adversarial",
          "class": "gate"
        },
        "security": {
          "agent": "review-security",
          "class": "gate"
        }
      }
    }
  }
}
