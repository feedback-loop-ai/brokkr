{
  "name": "verify",
  "policy": "policy.json",
  "protected_phase": "review",
  "seats": {
    "verify": {
      "results": [
        "pass",
        "fail"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "scripts/verify-seat.sh",
          "{prompt_file}"
        ]
      },
      "hands": {"kind": "workspace", "network": false, "binds": [
        {"path": "~/.cargo", "mode": "overlay", "mask": ["credentials.toml", "credentials"]},
        {"path": "~/.rustup", "mode": "ro"}
      ]}
    },
    "review": {
      "role": "roles/reviewer.md",
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "class": "gate",
      "inputs": [
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 3600
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "claude",
          "--",
          "--model",
          "claude-fable-5-1",
          "--effort",
          "high",
          "--permission-mode",
          "acceptEdits",
          "--allowedTools",
          "Bash(cargo:*),Bash(git:*),Bash(python3:*),Bash(.venv/bin/pytest:*),Bash(ls:*),Bash(rg:*),Bash(gh pr view:*),Bash(gh run view:*)"
        ]
      }
    }
  }
}
