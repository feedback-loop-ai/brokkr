{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://feedback-loop.ai/forge/contracts/panel-carry.v1.json",
  "title": "Forge panel carry v1 (an additive payload extension at event_schema 1)",
  "description": "Decision 0093 (proposed), rulings 1 to 4. Optional evidence on panel terminal facts, carried entries on effect/started, and member selection on retry operator/commanded. The fold reads none of these fields.",
  "type": "object",
  "properties": {
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_start",
        "at_end"
      ],
      "properties": {
        "at_start": {
          "enum": [
            "clean",
            "dirty",
            "refused",
            "unrun"
          ]
        },
        "at_end": {
          "enum": [
            "clean",
            "dirty",
            "refused",
            "unrun"
          ]
        }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at_start": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "at_end": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "settled_members": {
      "type": "object",
      "additionalProperties": {}
    },
    "carried": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member",
          "attempt_id"
        ],
        "properties": {
          "member": {
            "type": "string"
          },
          "attempt_id": {
            "type": "string"
          }
        }
      }
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "dependencies": {
    "head": [
      "tree"
    ],
    "settled_members": [
      "tree"
    ]
  },
  "allOf": [
    {
      "if": {
        "required": [
          "args"
        ],
        "properties": {
          "args": {
            "required": [
              "members"
            ]
          }
        }
      },
      "then": {
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "const": "retry"
          }
        }
      }
    }
  ]
}
