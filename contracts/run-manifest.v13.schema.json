{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://feedback-loop.ai/forge/contracts/run-manifest.v13.json",
  "title": "Forge run manifest v13",
  "description": "v12 plus what each capability candidate is served on (decision 0068 ruling 3, #430): every candidate record carries one REQUIRED model_pins record, the concrete model ids the compile read for it, so admission counts a running run by what its own compile seated and never resolves an abstract model again through another workspace's adapters. An agent candidate's id is the one its adapter maps its model to; an inline built-in model driver's are its --model pin and any --fallback-model, primary first; a driver that takes no model (exec, a custom command) reads none. Where an inline pin cannot be read as one concrete id the record names the flags instead, and admission holds a run that seats it. A route is the prefix of an id before its first /. No other clause moved. As in v12 the capabilities key is BUNDLE identity, so a changed pin moves the bundle digest.",
  "type": "object",
  "required": ["engine", "event_schema", "database_schema", "driver_protocol", "bundle_name", "files", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "engine": {"type": "string"},
    "event_schema": {"const": 1},
    "database_schema": {"const": 1},
    "driver_protocol": {"const": 1},
    "bundle_name": {"type": "string"},
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "agents": {"type": "object"},
    "realms": {"type": "object"},
    "crossings": {
      "type": "object",
      "description": "publishing realm to crossing name to what the loader OBSERVED for it at run start (decision 0057 rulings 1 and 2); every crossing the world publishes is here, consumed or not, and the digest is over the published file's RAW bytes",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["source", "sha256"],
          "additionalProperties": false,
          "properties": {
            "source": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["realm", "grants", "definitions", "dialects", "sites"],
      "additionalProperties": false,
      "properties": {
        "realm": {"type": "string", "minLength": 1, "description": "the operated realm's name, or <unmapped> where no map names the repository"},
        "grants": {
          "type": "object",
          "description": "capability to the grant the operated realm declares for it, held or not; restriction keys ride beside dialect, tools and offices exactly as written",
          "additionalProperties": {
            "type": "object",
            "required": ["dialect"],
            "properties": {
              "dialect": {"type": "string", "minLength": 1},
              "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "offices": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "definitions": {
          "type": "object",
          "description": "capability to the operator's abstract definition the compile consulted, for a held, dropped or subtracted ask and for an unused grant alike",
          "additionalProperties": {
            "type": "object",
            "required": ["source", "sha256", "classes"],
            "additionalProperties": false,
            "properties": {
              "source": {"$ref": "#/definitions/relative"},
              "sha256": {"$ref": "#/definitions/sha256"},
              "classes": {"$ref": "#/definitions/classes"}
            }
          }
        },
        "dialects": {
          "type": "object",
          "description": "tool dialect to the file a grant of the operated realm selected",
          "additionalProperties": {
            "type": "object",
            "required": ["source", "sha256", "kind", "serves"],
            "additionalProperties": false,
            "properties": {
              "source": {"$ref": "#/definitions/relative"},
              "sha256": {"$ref": "#/definitions/sha256"},
              "kind": {"enum": ["provider-native", "mcp", "hands"]},
              "serves": {"type": "string", "minLength": 1}
            }
          }
        },
        "sites": {
          "type": "object",
          "description": "executable site to its office, asks and per-candidate outcomes",
          "additionalProperties": {
            "type": "object",
            "required": ["office", "asks", "subtracted", "candidates"],
            "additionalProperties": false,
            "properties": {
              "office": {"type": "string", "minLength": 1},
              "asks": {"type": "object", "additionalProperties": {"enum": ["requires", "wants"]}},
              "subtracted": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "candidates": {"type": "array", "items": {"$ref": "#/definitions/capability_candidate"}}
            }
          }
        }
      }
    },
    "drivers": {"type": "object"},
    "hands": {
      "type": "object",
      "description": "site to box spec",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "network", "binds"],
        "additionalProperties": false,
        "properties": {
          "kind": {"const": "workspace"},
          "network": {"type": "boolean"},
          "binds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "mode", "mask"],
              "additionalProperties": false,
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "mode": {"enum": ["ro", "rw", "overlay"]},
                "mask": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "description": "hands site to the boundary its box stands behind (decision 0046 ruling 1); the key set equals the hands key set by construction, every value the realm's one resolved word",
      "additionalProperties": {"enum": ["namespace", "seatbelt", "container", "harness", "open"]}
    },
    "select": {
      "type": "object",
      "minProperties": 1,
      "description": "selecting site to its pinned resolved cases",
      "additionalProperties": {"$ref": "#/definitions/cases"}
    }
  },
  "dependencies": {
    "hands": ["boundary"],
    "boundary": ["hands"]
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative": {"type": "string", "minLength": 1, "pattern": "^(?![/\\\\]|[A-Za-z]:)(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$)).+$"},
    "classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["reads", "writes", "egress"]}},
    "implementation": {
      "description": "what carries the held capability: exactly one kind and that kind's facts",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "provider", "adapter_key"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "provider-native"},
            "provider": {"type": "string", "minLength": 1},
            "adapter_key": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["kind", "server", "connection", "version", "secrets"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "mcp"},
            "server": {"type": "string", "pattern": "^cap-.+$"},
            "connection": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": false,
              "properties": {
                "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "url": {"type": "string", "pattern": "^https?://[^@/]+(/.*)?$"}
              }
            },
            "version": {"type": "string", "minLength": 1},
            "secrets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
          }
        }
      ]
    },
    "retention": {
      "type": "object",
      "required": ["declared", "realm", "effective"],
      "additionalProperties": false,
      "properties": {
        "declared": {"type": "boolean", "description": "the dialect's retained, false where omitted and for every provider-native dialect"},
        "realm": {"enum": ["inherit", "veto"], "description": "veto where the grant writes the v8 retain false; inherit otherwise"},
        "effective": {"type": "boolean", "description": "declared and not vetoed"}
      }
    },
    "model_pins": {
      "description": "the concrete model ids the compile read for one candidate, primary first, each with its route before its first / (read: none for a driver that takes no model), or the flags on which an inline pin could not be read as one concrete id (unreadable)",
      "oneOf": [
        {
          "type": "object",
          "required": ["read"],
          "additionalProperties": false,
          "properties": {"read": {"type": "array", "items": {"type": "string", "minLength": 1}}}
        },
        {
          "type": "object",
          "required": ["unreadable"],
          "additionalProperties": false,
          "properties": {"unreadable": {"type": "array", "items": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "capability_candidate": {
      "type": "object",
      "required": ["provider", "held", "not_held", "notices", "native", "model_pins"],
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_pins": {"$ref": "#/definitions/model_pins"},
        "held": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["classes", "dialect", "dialect_sha256", "definition_sha256", "tools", "restrictions", "implementation", "retention"],
            "additionalProperties": false,
            "properties": {
              "classes": {"$ref": "#/definitions/classes"},
              "dialect": {"type": "string", "minLength": 1},
              "dialect_sha256": {"$ref": "#/definitions/sha256"},
              "definition_sha256": {"$ref": "#/definitions/sha256"},
              "tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "restrictions": {"type": "object"},
              "implementation": {"$ref": "#/definitions/implementation"},
              "retention": {"$ref": "#/definitions/retention"}
            }
          }
        },
        "not_held": {"type": "object", "description": "capability to the complete reason this candidate does not hold it", "additionalProperties": {"type": "string", "minLength": 1}},
        "notices": {"type": "array", "description": "one complete sentence per wanted capability this candidate lost", "items": {"type": "string", "minLength": 1}},
        "native": {
          "description": "what the serving adapter declares of its own powers, and what was composed from it: a known inventory names the native keys switched on and off; an unmeasured one carries its reason and claims no denial",
          "oneOf": [
            {
              "type": "object",
              "required": ["inventory", "declaration", "on", "off"],
              "additionalProperties": false,
              "properties": {
                "inventory": {"const": "known"},
                "declaration": {"$ref": "#/definitions/sha256"},
                "on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "off": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "unmeasured": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "native keys the candidate does not hold whose OFF control nobody has measured: not switched on, and not claimed denied"}
              }
            },
            {
              "type": "object",
              "required": ["inventory", "reason"],
              "additionalProperties": false,
              "properties": {
                "inventory": {"const": "unmeasured"},
                "declaration": {"$ref": "#/definitions/sha256"},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["provider", "model", "effort"],
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": ["string", "null"]}
      }
    },
    "single": {
      "oneOf": [
        {
          "type": "object",
          "required": ["driver"],
          "additionalProperties": false,
          "properties": {"driver": {"const": "inline"}}
        },
        {
          "type": "object",
          "required": ["agent", "candidates"],
          "additionalProperties": false,
          "properties": {
            "agent": {"type": "string", "minLength": 1},
            "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/candidate"}}
          }
        }
      ]
    },
    "panel": {
      "type": "object",
      "required": ["panel", "aggregate"],
      "additionalProperties": false,
      "properties": {
        "panel": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/single"}},
        "aggregate": {"enum": ["unanimous-pass", "review-panel"]}
      }
    },
    "step": {
      "type": "object",
      "required": ["name", "results", "body"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "body": {"oneOf": [{"$ref": "#/definitions/single"}, {"$ref": "#/definitions/panel"}]}
      }
    },
    "body": {
      "oneOf": [
        {"$ref": "#/definitions/single"},
        {"$ref": "#/definitions/panel"},
        {
          "type": "object",
          "required": ["sequence"],
          "additionalProperties": false,
          "properties": {"sequence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/step"}}}
        }
      ]
    },
    "cases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "chore": {"$ref": "#/definitions/body"},
        "feature": {"$ref": "#/definitions/body"},
        "design": {"$ref": "#/definitions/body"},
        "engine": {"$ref": "#/definitions/body"},
        "default": {"$ref": "#/definitions/body"}
      }
    }
  }
}
