{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback-loop.ai/forge/contracts/work-order.v1.json",
  "title": "Work order v1 header",
  "description": "The JSON header of a work order (decision 0116). Intent and acceptance are its Markdown body. Tracker membership, link hosts and ask-to-ruling lookups are checked with the document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "state", "rulings", "asks", "constraints", "caps", "references", "edges"],
  "properties": {
    "id": {
      "$ref": "#/$defs/id",
      "description": "Brokkr's realm-local id, absent until the work order is added."
    },
    "title": {
      "type": "string",
      "pattern": "\\S",
      "not": { "pattern": "[\\r\\n]" }
    },
    "state": {
      "type": "string",
      "enum": ["proposed", "ruled", "queued", "in-progress", "shipped", "merged", "withdrawn", "superseded", "delivered-elsewhere"]
    },
    "rulings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["words", "date", "cite"],
        "properties": {
          "words": { "type": "string" },
          "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "cite": { "type": "string", "format": "uri" }
        }
      }
    },
    "asks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "question"],
        "properties": {
          "number": { "$ref": "#/$defs/number" },
          "question": { "type": "string" },
          "ruling": {
            "$ref": "#/$defs/number",
            "description": "The closing ruling's one-based position in rulings. Omitted while the ask is open."
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tracker", "item", "link"],
        "properties": {
          "tracker": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "item": { "type": "string" },
          "link": { "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#]+" }
        }
      }
    },
    "parent": { "$ref": "#/$defs/id" },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["awaits", "condition"],
        "properties": {
          "awaits": { "$ref": "#/$defs/id" },
          "condition": {
            "type": "string",
            "enum": [
              "completed", "ended", "merged",
              "shipped", "shipped-flagged", "refused", "failed", "blocked", "exhausted",
              "superseded", "infrastructure", "delivered-elsewhere", "withdrawn", "operator-stopped"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^WO-[1-9][0-9]*$" },
    "number": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
  }
}
